<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 현재 위치 버튼의 원형 흰색 배경 -->
    <solid android:color="#FFFFFF" />

    <!-- 배경과 버튼을 구분하는 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#E1E5EA" />

    <!-- 원형 버튼의 고정 크기 -->
    <size
        android:width="48dp"
        android:height="48dp" />

</shape>
