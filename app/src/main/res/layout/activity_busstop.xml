<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F8">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stop_info_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202936" />

        <TextView
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/symbol_home"
            android:textSize="27sp"
            android:textColor="#155BC1"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 정류장 정보 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <!-- 정류장 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvStopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_stop_name"
                android:textColor="#182235"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStopDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sample_walking_distance"
                android:textSize="13sp"
                android:textColor="#737D8C" />

            <!-- Kotlin에서 실시간 버스 도착 카드를 동적으로 추가하는 영역 -->
            <LinearLayout
                android:id="@+id/busArrivalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBusStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/bus_arrivals_loading"
                    android:textColor="#737D8C"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/btnRouteDetail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/view_bus_route_detail"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_busstop_route"
        android:clickable="true"
        android:focusable="true" />

    <!-- 경로 찾기 버튼 -->
    <TextView
        android:id="@+id/btnFindRoute"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/find_route_with_bus"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_busstop_route"
        android:clickable="true"
        android:focusable="true" />

    <!-- 하단 내비게이션 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navRoute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_route"
            android:textSize="15sp"
            android:textColor="#475467"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navBookmark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_booking"
            android:textSize="15sp"
            android:textColor="#475467"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_profile"
            android:textSize="15sp"
            android:textColor="#475467"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
